# Base URL of your codex runner. server.py appends /exec automatically.
CODEX_URL=http://localhost:3000

# Port the chat UI runs on (for `ngrok http 3000`)
PORT=8080

# Hidden prefix sent before every prompt. Never shown in the chat UI.
SYSTEM_PROMPT=Your name is Nomi.

# Working directory codex runs in
WORKDIR=/tmp/my-project